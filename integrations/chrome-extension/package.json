{
  "name": "@tradik/mddb-browser-extension",
  "version": "0.1.0",
  "description": "Chrome (Manifest V3) extension that surfaces live MDDB server stats and a quick link to the admin panel from the browser toolbar.",
  "private": true,
  "license": "BSD-3-Clause",
  "author": "tradik",
  "homepage": "https://github.com/tradik/mddb/tree/main/integrations/chrome-extension",
  "repository": {
    "type": "git",
    "url": "https://github.com/tradik/mddb.git",
    "directory": "integrations/chrome-extension"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "package": "node scripts/package.mjs",
    "lint": "eslint src __tests__ --ext .ts",
    "format": "prettier --write \"src/**/*.ts\" \"__tests__/**/*.ts\" \"public/**/*.{html,css,json}\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"__tests__/**/*.ts\" \"public/**/*.{html,css,json}\"",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "audit": "npm audit --omit=dev --audit-level=high",
    "all": "npm run format:check && npm run lint && npm run test:coverage && npm run build && npm run package"
  },
  "devDependencies": {
    "@types/chrome": "^0.2.2",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.1.0",
    "@typescript-eslint/eslint-plugin": "^8.63.0",
    "@typescript-eslint/parser": "^8.20.0",
    "esbuild": "^0.28.1",
    "eslint": "^10.6.0",
    "jest": "^30.0.0",
    "jest-environment-jsdom": "^30.0.0",
    "prettier": "^3.9.4",
    "ts-jest": "^29.2.5",
    "typescript": "^7.0.2",
    "undici": "^8.7.0"
  }
}
