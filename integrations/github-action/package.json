{
  "name": "@tradik/mddb-sync-action",
  "version": "0.1.0",
  "description": "GitHub Action that syncs repository files into an MDDB collection via POST /v1/add.",
  "private": true,
  "license": "BSD-3-Clause",
  "author": "tradik",
  "homepage": "https://github.com/tradik/mddb/tree/main/integrations/github-action",
  "repository": {
    "type": "git",
    "url": "https://github.com/tradik/mddb.git",
    "directory": "integrations/github-action"
  },
  "main": "dist/index.js",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "ncc build src/main.ts --source-map --license licenses.txt --minify",
    "lint": "eslint src __tests__ --ext .ts",
    "format": "prettier --write \"src/**/*.ts\" \"__tests__/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"__tests__/**/*.ts\"",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest",
    "test:coverage": "NODE_OPTIONS=--experimental-vm-modules jest --coverage",
    "all": "npm run format:check && npm run lint && npm run test:coverage && npm run build"
  },
  "dependencies": {
    "@actions/core": "^3.0.1",
    "@actions/glob": "^0.7.0",
    "undici": "^8.10.1"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^26.4.1",
    "@typescript-eslint/eslint-plugin": "^8.69.0",
    "@typescript-eslint/parser": "^8.20.0",
    "@vercel/ncc": "^0.45.0",
    "eslint": "^10.9.1",
    "jest": "^30.5.1",
    "prettier": "^3.9.6",
    "ts-jest": "^29.4.12",
    "typescript": "^6.0.3"
  }
}
