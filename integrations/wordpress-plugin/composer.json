{
    "name": "tradik/mddb-sync",
    "description": "WordPress plugin that synchronises posts and pages to an MDDB instance.",
    "type": "wordpress-plugin",
    "license": "BSD-3-Clause",
    "require": {
        "php": ">=8.2"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.4",
        "brain/monkey": "^2.6",
        "mockery/mockery": "^1.6",
        "phpstan/phpstan": "^1.11",
        "szepeviktor/phpstan-wordpress": "^1.3",
        "squizlabs/php_codesniffer": "^3.10",
        "wp-coding-standards/wpcs": "^3.1",
        "phpcompatibility/phpcompatibility-wp": "^2.1",
        "dealerdirect/phpcodesniffer-composer-installer": "^1.0"
    },
    "autoload": {
        "classmap": [
            "includes/"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tradik\\MddbSync\\Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        },
        "sort-packages": true,
        "optimize-autoloader": true,
        "preferred-install": "dist"
    },
    "scripts": {
        "lint": "phpcs --standard=phpcs.xml --runtime-set testVersion 8.2- -p",
        "lint:fix": "phpcbf --standard=phpcs.xml",
        "stan": "phpstan analyse --memory-limit=2G",
        "test": "phpunit",
        "test:coverage": "XDEBUG_MODE=coverage phpunit --coverage-text --coverage-clover=coverage.xml",
        "audit": "composer audit --abandoned=report",
        "ci": [
            "@audit",
            "@lint",
            "@stan",
            "@test:coverage"
        ]
    },
    "scripts-descriptions": {
        "lint": "Run PHPCS with the WordPress + PHPCompatibility rulesets.",
        "stan": "Run PHPStan static analysis (WordPress-aware).",
        "test": "Run PHPUnit.",
        "test:coverage": "Run PHPUnit with code coverage (clover + text).",
        "audit": "Run composer audit (security advisories)."
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
