# MDDB Development Environment Variables
# Copy this file to .env and adjust values as needed

# Release version stamped into docker-compose image labels (com.mddb.version).
# Single source of truth (OPS-003) — compose falls back to the default below
# when unset, so `docker compose config` renders identically without a .env.
MDDB_VERSION=2.13.0

# Database Configuration
MDDB_PATH=/data/mddb.db
MDDB_MODE=wr

# Server Configuration
MDDB_ADDR=:11023
MDDB_GRPC_ADDR=:11024

# Host interface docker-compose publishes every service on (OPS-001/OPS-012).
# Defaults to loopback: behind a reverse proxy or cloudflared nothing needs to
# be reachable from outside the host, and the tunnel talks to the containers
# over mddb-network regardless. Set 0.0.0.0 to expose the ports deliberately —
# only ever alongside the authentication settings below.
MDDB_BIND_ADDR=127.0.0.1

# Authentication (set MDDB_AUTH_ENABLED=false to disable).
# docker-compose.yml hardcodes MDDB_AUTH_ENABLED=true and refuses to start
# without the secret and admin password below — the image itself defaults to
# auth disabled, which is fine for a bare `docker run` but not for the
# production compose, which runs read-write and publishes MCP.
MDDB_AUTH_ENABLED=true
MDDB_AUTH_JWT_SECRET=change-this-to-a-secure-random-string-min-32-chars
MDDB_AUTH_JWT_EXPIRY=24h
MDDB_AUTH_ADMIN_USERNAME=admin
MDDB_AUTH_ADMIN_PASSWORD=changeme

# Logging (GO-028). The operational log is structured: `text` is the readable
# default for a terminal, `json` gives one object per line for a collector —
# the container image sets json for that reason. Level filters at the source.
MDDB_LOG_FORMAT=text
MDDB_LOG_LEVEL=info
# One log line per HTTP request (method, path, status, bytes, elapsed, remote).
# Off by default: the volume is the operator's decision. The query string is
# never logged, because search endpoints carry user content there.
MDDB_ACCESS_LOG=false

# Minimum free disk space (bytes) below which the server warns at startup and
# in /health. bbolt fsyncs every commit, but a full filesystem fails writes —
# this makes the approach visible before it does. 0 disables the check.
MDDB_DISK_MIN_FREE=104857600

# How long the ordered shutdown may take before the process stops waiting for
# a subsystem that will not finish (GO-034). The step that wedged is named in
# the log; an operator's SIGTERM is followed by a SIGKILL soon enough anyway.
MDDB_SHUTDOWN_TIMEOUT_SEC=15

# Bounded concurrency for heavy queries (GO-033). A single-binary server has
# nowhere to shed load: past some width, parallel searches do not slow down,
# they exhaust memory. Queries beyond the limit queue for up to the timeout and
# then get a retryable 503. Default = CPU count; 0 disables the limiter.
MDDB_SEARCH_MAX_CONCURRENT=
MDDB_SEARCH_QUEUE_TIMEOUT_MS=2000

# How embedding chunks are cut (CODE-003). Empty follows the document: source
# (kind=code, or a known extension) is split on bracket depth so a chunk is a
# whole rule or function; everything else splits on paragraphs. Set code or
# prose to force one for the whole server.
MDDB_EMBEDDING_CHUNK_MODE=

# Search-result cache (GO-031). Opt-in per request: a search sets `cacheTtl`
# (seconds) to say how stale an answer may be, and a request without it is
# neither served from nor stored in the cache — so the default behaviour and
# the default freshness are unchanged. Writes to a collection invalidate its
# entries immediately. 0 disables the cache regardless of what requests ask.
MDDB_SEARCH_CACHE_SIZE=500

# Features
MDDB_METRICS=true
# When MDDB_AUTH_ENABLED=true, /metrics requires credentials by default (SEC-009).
# Set MDDB_METRICS_PUBLIC=true to expose /metrics without auth (e.g. a trusted
# network where Prometheus cannot send a Bearer token). Has no effect when auth
# is disabled — /metrics is already open in that case.
MDDB_METRICS_PUBLIC=false
MDDB_EXTREME=false
# Max request body size in bytes for /v1/* JSON endpoints (SEC-005). Oversized
# requests get HTTP 413. /v1/upload and /v1/import-wiki are exempt (they stream
# large files). Default 32 MiB.
MDDB_MAX_BODY_BYTES=33554432
# Wiki import (/v1/import-wiki) safety caps (SEC-006). Decompressed-byte budget
# bounds a bz2 decompression bomb; page cap bounds total imported pages. Raise
# both for full Wikipedia dumps.
MDDB_WIKI_MAX_DECOMPRESSED_BYTES=4294967296
MDDB_WIKI_MAX_PAGES=500000
# Outbound SSRF protection (SEC-004). Webhooks / import-url / automation /
# bulk callbacks refuse private, loopback, link-local and cloud-metadata
# destinations by default. On a trusted intranet, opt out globally with
# MDDB_OUTBOUND_ALLOW_PRIVATE=true, or allow specific hosts (comma-separated).
MDDB_OUTBOUND_ALLOW_PRIVATE=false
# MDDB_OUTBOUND_ALLOWLIST=internal.example.com,ollama

# Replication (leader/follower). The snapshot + binlog gRPC streams are gated by
# authorizeReplication (SEC-001): set a shared secret here on BOTH leader and
# follower for cross-host links without full mTLS — it is compared in constant
# time against the x-mddb-replication-secret gRPC metadata. Alternatives that
# also satisfy the gate: a verified mTLS client cert, or MDDB_AUTH_ENABLED=true
# with admin credentials. A leader with role=leader and none of these configured
# refuses snapshot/binlog requests and logs a startup warning.
# MDDB_REPLICATION_ROLE=leader
# MDDB_REPLICATION_SECRET=change-this-to-a-shared-random-string-min-32-chars

# CORS (SEC-008). Allowlist of exact browser origins permitted to read responses
# cross-origin. Comma-separated; only a matching Origin is echoed (with Vary).
# "*" is wildcard (any site can read this instance from a user's browser — set a
# real allowlist for non-public deployments). Falls back to legacy
# MDDB_CORS_ORIGIN when unset.
MDDB_CORS_ORIGINS=*
# MDDB_CORS_ORIGINS=https://app.example.com,https://admin.example.com

# Vector Search / Embeddings (optional)
# Options: openai, ollama, voyage
MDDB_EMBEDDING_PROVIDER=ollama
MDDB_EMBEDDING_API_URL=http://ollama:11434
MDDB_EMBEDDING_API_KEY=
MDDB_EMBEDDING_MODEL=nomic-embed-text
MDDB_EMBEDDING_DIMENSIONS=768

# Embedding cache (v2.12.0+). Every vector, hybrid and memory-recall query calls
# the provider — a network round trip and a token charge even for a query asked
# seconds ago. Cached by (model, text); 0 disables it entirely.
# MDDB_EMBEDDING_CACHE_SIZE=1024
# MDDB_EMBEDDING_CACHE_TTL=3600

# Panel Configuration
# Panel dev server target — the GraphQL client reads VITE_SERVER_URL (full URL).
VITE_SERVER_URL=http://localhost:11023
NODE_ENV=development
