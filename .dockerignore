.windsurf
.windsurf/rules/*

# Git
.git
.gitignore
.gitattributes

# Documentation (any depth)
*.md
**/*.md
docs/
LICENSE

# Development files (any depth)
.vscode/
.idea/
**/*.swp
**/*.swo
**/*~
**/.DS_Store

# Build artifacts (any depth)
**/*.exe
**/*.exe~
**/*.dll
**/*.so
**/*.dylib
**/*.test
**/*.out
**/coverage.html
**/coverage-*.html
**/coverage.out
**/coverage/

# Rust / cargo build output (can be gigabytes) — any depth
**/target/

# Database files (any depth)
**/*.db
**/backup-*.db

# Temporary files (any depth)
**/tmp/
**/*.tmp
**/*.temp
**/*.log

# Air config (will be generated in container)
.air.toml

# Docker files
Dockerfile*
docker-compose*.yml
.dockerignore

# CI/CD
.github/
.gitlab-ci.yml

# Environment (any depth)
**/.env*

# Node modules (any depth — host installs must never override image installs)
**/node_modules/

# Integration: GitHub Action (Node-based; not shipped in any Docker image)
integrations/github-action/coverage/
integrations/github-action/build/

# Integration: Chrome extension (browser-side; not shipped in any Docker image)
integrations/chrome-extension/node_modules/
integrations/chrome-extension/coverage/
integrations/chrome-extension/build/
integrations/chrome-extension/dist/

# Python (any depth)
**/__pycache__/
**/*.py[cod]
**/*.egg-info/
**/dist/
**/build/

# Go
**/vendor/
go.work

# Local audit findings — never shipped in any image
audit/
AUDIT_REPORT.md

# ssg build cache
.ssg-cache/
